{
	"name": "opencode-sockless-llm-router",
	"version": "0.1.0",
	"description": "OpenCode provider plugin for Sockless LLM Router — point it at the router's API endpoint and every model is discovered automatically, with context size, tool-calling, vision and reasoning support carried over.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"author": "Jimmy Everling",
	"repository": {
		"type": "git",
		"url": "https://github.com/sockless-coding/llm-router-opencode-provider.git"
	},
	"keywords": [
		"opencode",
		"opencode-plugin",
		"llm-router",
		"llama.cpp",
		"provider"
	],
	"scripts": {
		"build": "tsc -p .",
		"watch": "tsc -w -p .",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@opencode-ai/plugin": "^1.18.21",
		"@opencode-ai/sdk": "^1.18.21",
		"@types/node": "^22.x",
		"typescript": "^5.9.2"
	}
}
